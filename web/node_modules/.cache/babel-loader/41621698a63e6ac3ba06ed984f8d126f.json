e(\r\n  response => {\r\n    const res = response.data\r\n    const config = response.config\r\n    // Binary stream handling\r\n    if (config && config.responseType === 'blob') {\r\n      return response\r\n    }\r\n\r\n    return res\r\n  },\r\n  error => {\r\n    console.log('Request error: ' + error)\r\n\r\n    if (error.response.status === 401) {\r\n      MessageBox.confirm('Login status expired, please login again', 'System', {\r\n        confirmButtonText: 'Login',\r\n        cancelButtonText: 'Cancel',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        logoutSys().then(res => {\r\n          sessionStorage.clear();\r\n          router.replace({\r\n            path: '/login',\r\n          })\r\n        })\r\n      })\r\n    }else {\r\n      Message({\r\n        message: error.message,\r\n        type: 'error',\r\n        duration: 2000\r\n      })\r\n      return Promise.reject(error)\r\n    }\r\n\r\n  }\r\n)\r\n\r\nexport default service\r\n"],"mappings":";;;;;;;;;;AAAA,IAAAA,MAAA,GAAAC,sBAAA,CAAAC,OAAA;AACA,IAAAC,UAAA,GAAAD,OAAA;AACA,IAAAE,OAAA,GAAAH,sBAAA,CAAAC,OAAA;AACA,IAAAG,MAAA,GAAAH,OAAA;AAEA;AACA,IAAMI,OAAO,GAAGC,cAAK,CAACC,MAAM,CAAC;EAC3BC,OAAO,EAAEC,OAAO,CAACC,GAAG,CAACC,gBAAgB;EAAE;EACvCC,OAAO,EAAE,MAAM,CAAC;AAClB,CAAC,CAAC;;AAEF;AACAP,OAAO,CAACQ,YAAY,CAACC,OAAO,CAACC,GAAG,CAC9B,UAAAC,MAAM,EAAI;EACR,OAAOA,MAAM;AACf,CAAC,EACD,UAAAC,KAAK,EAAI;EACPC,OAAO,CAACC,GAAG,CAACF,KAAK,CAAC;EAClB,OAAOG,OAAO,CAACC,MAAM,CAACJ,KAAK,CAAC;AAC9B,CACF,CAAC;;AAED;AACAZ,OAAO,CAACQ,YAAY,CAACS,QAAQ,CAACP,GAAG,CAC/B,UAAAO,QAAQ,EAAI;EACV,IAAMC,GAAG,GAAGD,QAAQ,CAACE,IAAI;EACzB,IAAMR,MAAM,GAAGM,QAAQ,CAACN,MAAM;EAC9B;EACA,IAAIA,MAAM,IAAIA,MAAM,CAACS,YAAY,KAAK,MAAM,EAAE;IAC5C,OAAOH,QAAQ;EACjB;EAEA,OAAOC,GAAG;AACZ,CAAC,EACD,UAAAN,KAAK,EAAI;EACPC,OAAO,CAACC,GAAG,CAAC,iBAAiB,GAAGF,KAAK,CAAC;EAEtC,IAAIA,KAAK,CAACK,QAAQ,CAACI,MAAM,KAAK,GAAG,EAAE;IACjCC,qBAAU,CAACC,OAAO,CAAC,0CAA0C,EAAE,QAAQ,EAAE;MACvEC,iBAAiB,EAAE,OAAO;MAC1BC,gBAAgB,EAAE,QAAQ;MAC1BC,IAAI,EAAE;IACR,CAAC,